# X (Twitter) Developer App Credentials (OAuth 2.0 PKCE)
TWITTER_CLIENT_ID=your_twitter_client_id_here
TWITTER_CLIENT_SECRET=your_twitter_client_secret_here
TWITTER_REDIRECT_URI=http://localhost:3001/api/twitter/auth/callback

# Optional Twitter v2 Bearer Token / API Keys (for read-only or elevated direct access)
TWITTER_BEARER_TOKEN=your_bearer_token_here

# Server Configuration
PORT=3001
NODE_ENV=development
